# Managed by the AIOps website playbook for {{ demo_website_config.hostname }}.
{% if demo_website_tls_ready %}
limit_req_zone $binary_remote_addr zone={{ demo_website_config.rate_limit_zone }}:10m rate=2r/m;
proxy_cache_path {{ demo_website_config.cache_path }}
    levels=1:2 keys_zone={{ demo_website_config.cache_zone }}:1m
    inactive=1h max_size=10m use_temp_path=off;
{% endif %}

server {
    listen 80;
    server_name {{ demo_website_config.hostname }};
    location /.well-known/acme-challenge/ {
        root /var/lib/letsencrypt;
    }
    location / {
{% if demo_website_tls_ready %}
        return 301 https://$host$request_uri;
{% else %}
        return 503;
{% endif %}
    }
}
{% if demo_website_tls_ready %}

server {
    listen 443 ssl;
    server_name {{ demo_website_config.hostname }};
    ssl_certificate /etc/letsencrypt/live/{{ demo_website_config.hostname }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ demo_website_config.hostname }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=300" always;
    root {{ demo_website_root }};
    index index.html;

    location = /favicon.ico {
        access_log off;
        log_not_found off;
    }
    location = /armed {
        alias {{ demo_button_marker }};
        default_type text/plain;
        add_header Cache-Control "no-store" always;
        add_header Strict-Transport-Security "max-age=300" always;
    }
    location = /api/panic {
        include {{ demo_website_rate_limit_file }};
        if (!-f {{ demo_button_marker }}) { return 423; }
        limit_except POST { deny all; }
        client_max_body_size 1k;
        proxy_request_buffering on;
        proxy_buffering on;
        proxy_cache {{ demo_website_config.cache_zone }};
        proxy_cache_methods POST;
        proxy_cache_key "$request_method|$uri|$request_body";
        proxy_cache_lock on;
        proxy_cache_lock_timeout 30s;
        proxy_cache_lock_age 30s;
        proxy_cache_valid 202 1h;
        proxy_ignore_headers X-Accel-Expires Expires Cache-Control Set-Cookie Vary;
        proxy_hide_header Set-Cookie;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
        proxy_send_timeout 10s;
        proxy_next_upstream off;

        proxy_set_header X-Gitlab-Token "{{ demo_website_webhook_key }}";
        proxy_set_header X-Gitlab-Event "Push Hook";
        proxy_set_header Content-Type "application/json";
        proxy_set_header Host {{ demo_website_config.aap_hostname }};
        proxy_http_version 1.1;
        proxy_pass https://{{ demo_website_config.aap_hostname }}/api/controller/v2/job_templates/{{ demo_website_fault_template_id | int }}/gitlab/;
        proxy_ssl_server_name on;
        proxy_ssl_name {{ demo_website_config.aap_hostname }};
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/pki/tls/certs/ca-bundle.crt;
        proxy_ssl_verify_depth 3;
    }
}
{% endif %}
