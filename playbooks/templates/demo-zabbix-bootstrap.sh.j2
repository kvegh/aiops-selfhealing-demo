#!/bin/sh
set -eu
# This script runs offline inside a newly converted clone, never the saved image.
truncate -s 0 /etc/machine-id
rm -f /var/lib/dbus/machine-id /var/lib/mysql/auto.cnf
rm -f /etc/udev/rules.d/70-persistent-net.rules
rm -f /etc/sysconfig/network-scripts/ifcfg-eth0
cat > /etc/sysconfig/network-scripts/ifcfg-eth0 <<'EOF'
DEVICE=eth0
TYPE=Ethernet
BOOTPROTO=dhcp
ONBOOT=yes
PEERDNS=yes
IPV6INIT=no
EOF
# Resolve selected HTTPS services to this verified hypervisor's bridge. Public
# DNS still points to its public address; this avoids NAT hairpin/routing changes.
# Keep this guest's name first: hostname --fqdn uses the first canonical alias.
printf '\n%s %s %s %s\n' {{ demo_zabbix_network.gateway | quote }} {{ demo_zabbix_config.hostname | quote }} {{ demo_zabbix_config.website_hostname | quote }} {{ demo_zabbix_config.aap_hostname | quote }} >> /etc/hosts
