#!/bin/sh
set -eu
# This script runs offline inside a newly converted clone, never the saved image.
ln -sf /dev/null /etc/systemd/system/zabbix-server.service
ln -sf /dev/null /etc/systemd/system/zabbix-agent.service
ln -sf /dev/null /etc/systemd/system/zabbix-agent2.service
truncate -s 0 /etc/machine-id
rm -f /var/lib/dbus/machine-id /var/lib/mysql/auto.cnf
rm -f /etc/udev/rules.d/70-persistent-net.rules
rm -f /etc/sysconfig/network-scripts/ifcfg-eth0
cat > /etc/sysconfig/network-scripts/ifcfg-eth0 <<'EOF'
DEVICE=eth0
TYPE=Ethernet
BOOTPROTO=dhcp
ONBOOT=yes
PEERDNS=yes
IPV6INIT=no
EOF
if ! id {{ demo_zabbix_config.guest_user | quote }} >/dev/null 2>&1; then
    useradd --create-home --shell /bin/bash {{ demo_zabbix_config.guest_user | quote }}
fi
install -d -m 0700 -o {{ demo_zabbix_config.guest_user | quote }} -g {{ demo_zabbix_config.guest_user | quote }} /home/{{ demo_zabbix_config.guest_user }}/.ssh
install -m 0600 -o {{ demo_zabbix_config.guest_user | quote }} -g {{ demo_zabbix_config.guest_user | quote }} /tmp/aiops-management.pub /home/{{ demo_zabbix_config.guest_user }}/.ssh/authorized_keys
printf '%s ALL=(ALL) NOPASSWD: ALL\n' {{ demo_zabbix_config.guest_user | quote }} > /etc/sudoers.d/90-aiops-management
chmod 0440 /etc/sudoers.d/90-aiops-management
for kind in ed25519 ecdsa rsa; do
    chmod 0600 /etc/ssh/ssh_host_${kind}_key
    chmod 0644 /etc/ssh/ssh_host_${kind}_key.pub
done
# Resolve selected HTTPS services to this verified hypervisor's bridge. Public
# DNS still points to its public address; this avoids NAT hairpin/routing changes.
# Keep this guest's name first: hostname --fqdn uses the first canonical alias.
printf '\n%s %s %s %s\n' {{ demo_zabbix_network.gateway | quote }} {{ demo_zabbix_config.hostname | quote }} {{ demo_zabbix_config.website_hostname | quote }} {{ demo_zabbix_config.aap_hostname | quote }} >> /etc/hosts
rm -f /tmp/aiops-management.pub
